#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
dlink,dsp-w215)
	# The DSP-W215 has no wired Ethernet — it is a Wi-Fi-only STA.
	# Networking is the wireless client configured in /etc/config/wireless.
	# Nothing to do here for wired interfaces.
	:
	;;
esac

board_config_flush

exit 0
