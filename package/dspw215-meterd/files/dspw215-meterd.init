#!/bin/sh /etc/rc.common
# procd init script for dspw215-meterd

START=95
USE_PROCD=1

start_service() {
	local enabled device broker port username password relay_gpio
	local name node_id base_topic discovery_prefix interval

	config_load dspw215
	config_get_bool enabled meter enabled 0
	config_get device          meter device '/dev/ttyS0'
	config_get broker          meter broker ''
	config_get port            meter port '1883'
	config_get username        meter username ''
	config_get password        meter password ''
	config_get relay_gpio      meter relay_gpio ''
	config_get name            meter name 'DSP-W215'
	config_get node_id         meter node_id ''
	config_get base_topic      meter base_topic 'dspw215'
	config_get discovery_prefix meter discovery_prefix 'homeassistant'
	config_get interval        meter interval '30'

	[ "$enabled" = "1" ] || return 0
	[ -n "$broker" ] || { echo "dspw215-meterd: set 'broker' in /etc/config/dspw215"; return 1; }
	[ -n "$node_id" ] || node_id="$(cat /proc/sys/kernel/hostname)"

	procd_open_instance
	procd_set_param command /usr/sbin/meterd \
		-H "$device" -b "$broker" -p "$port" \
		-n "$node_id" -N "$name" \
		-t "$base_topic" -d "$discovery_prefix" -i "$interval"
	[ -n "$username" ]  && procd_append_param command -u "$username"
	[ -n "$password" ]  && procd_append_param command -P "$password"
	[ -n "$relay_gpio" ] && procd_append_param command -g "$relay_gpio"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "dspw215"
}
