config meter 'meter'
	option enabled '0'
	option device '/dev/ttyS0'
	# MQTT broker (your Home Assistant / Mosquitto host)
	option broker '192.168.1.10'
	option port '1883'
	option username ''
	option password ''
	# Relay GPIO number — CONFIRM on hardware (see HARDWARE.md)
	option relay_gpio '14'
	# Friendly name + node id (node id defaults to hostname if empty)
	option name 'DSP-W215'
	option node_id ''
	option base_topic 'dspw215'
	option discovery_prefix 'homeassistant'
	option interval '30'
